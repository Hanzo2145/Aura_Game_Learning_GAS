# Unreal Engine must-have ignores
Binaries/
DerivedDataCache/
Intermediate/
Saved/
.vs/
.vscode/
.idea/

# Build artifacts
*.log
*.tlog
*.aps
*.tmp
*.cache
*.obj
*.pch
*.pdb
*.exe
*.sln

# OS fluff
.DS_Store
Thumbs.db

# Ignore autosaves and backups
Saved/Backup/
Saved/Autosaves/
*_BuiltData.uasset

# Keep project content & source
!Content/**
!Config/**
!Source/**

# Optional: ignore starter content / megascans if desired
# Content/StarterContent/**
# Content/Megascans/**
